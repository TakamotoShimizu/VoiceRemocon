<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/start_recognition_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Recognition"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stop_recognition_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/stop_recognition_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop Recognition"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/start_recognition_button"
        app:layout_constraintStart_toEndOf="@+id/start_recognition_button"
        app:layout_constraintEnd_toStartOf="@+id/start_rec_button" />

    <Button
        android:id="@+id/start_rec_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StartRec"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/stop_recognition_button"
        app:layout_constraintStart_toEndOf="@+id/stop_recognition_button"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/recognition_result_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="..."
        android:textAlignment="center"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_recognition_button" />

    <ProgressBar
        android:id="@+id/audio_level_progressbar_rec"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:max="32767"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recognition_result_textview" />

    <TextView
        android:id="@+id/amplitude_textview_rec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Amplitude: 0"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/audio_level_progressbar_rec"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>